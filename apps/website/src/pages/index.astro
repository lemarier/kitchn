    <script>
      for (const installer of document.querySelectorAll<HTMLElement>("[data-installer]")) {
        const tabs = [...installer.querySelectorAll<HTMLButtonElement>("[data-tab]")];
        const panels = [...installer.querySelectorAll<HTMLElement>("[role=tabpanel]")];
        const select = (index: number) => {
          tabs.forEach((tab, i) => {
            tab.setAttribute("aria-selected", String(i === index));
            tab.tabIndex = i === index ? 0 : -1;
          });
          panels.forEach((panel, i) => {
            panel.hidden = i !== index;
          });
        };
        tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => select(i));
          tab.addEventListener("keydown", (event) => {
            const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
            if (step === 0) return;
            const next = (i + step + tabs.length) % tabs.length;
            select(next);
            tabs[next]?.focus();
          });
        });
      }

      // Cycles the name in "A brigade for ___" through backends and agents.
      const rotator = document.querySelector<HTMLElement>("[data-rotator]");
      if (rotator && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const names = [...rotator.querySelectorAll<HTMLElement>(".rot")];
        let at = 0;
        window.setInterval(() => {
          const current = names[at];
          at = (at + 1) % names.length;
          const next = names[at];
          if (!current || !next) return;
          current.classList.remove("on");
          current.classList.add("out");
          next.classList.remove("out");
          next.classList.add("on");
          window.setTimeout(() => current.classList.remove("out"), 400);
        }, 2200);
      }

      // Station contracts open in a native dialog; Esc, Close or the backdrop dismiss it.
      for (const opener of document.querySelectorAll<HTMLButtonElement>("[data-open]")) {
        const dialog = document.getElementById(opener.dataset.open ?? "");
        if (!(dialog instanceof HTMLDialogElement)) continue;
        opener.addEventListener("click", () => dialog.showModal());
      }
      for (const dialog of document.querySelectorAll<HTMLDialogElement>("dialog.contract")) {
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
        dialog.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        button.addEventListener("click", async () => {
          const text = button.dataset.copy;
          if (text === undefined) return;
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "Copied";
          } catch {
            button.textContent = "Select and copy";
          }
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1800);
        });
      }

      // Command explorer: pick a command and its captured output types out.
      const term = document.querySelector<HTMLElement>("[data-term]");
      if (term) {
        const tabs = [...term.querySelectorAll<HTMLButtonElement>("[data-term-tab]")];
        const outs = [...term.querySelectorAll<HTMLElement>("[data-term-out]")];
        const summary = term.querySelector<HTMLElement>("[data-term-summary]");
        const docs = term.querySelector<HTMLAnchorElement>("[data-term-docs]");
        const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let timers: number[] = [];
        let current = 0;

        const type = (screen: HTMLElement) => {
          for (const t of timers) clearTimeout(t);
          timers = [];
          const lines = [...screen.querySelectorAll<HTMLElement>(".tl")];
          if (still) {
            for (const l of lines) l.classList.add("shown");
            return;
          }
          for (const l of lines) l.classList.remove("shown");
          let at = 0;
          for (const l of lines) {
            at += l.classList.contains("cmd") ? 150 : 110;
            timers.push(window.setTimeout(() => l.classList.add("shown"), at));
            if (l.classList.contains("cmd")) at += 450;
          }
        };

        const select = (index: number) => {
          current = index;
          tabs.forEach((tab, i) => {
            tab.setAttribute("aria-selected", String(i === index));
            tab.tabIndex = i === index ? 0 : -1;
          });
          outs.forEach((o, i) => {
            o.hidden = i !== index;
            o.setAttribute("aria-hidden", String(i !== index));
          });
          const screen = outs[index];
          if (!screen) return;
          if (summary) summary.textContent = screen.dataset.summary ?? "";
          if (docs && screen.dataset.docs) docs.href = screen.dataset.docs;
          type(screen);
        };

        tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => select(i));
          tab.addEventListener("keydown", (event) => {
            const step = event.key === "ArrowDown" ? 1 : event.key === "ArrowUp" ? -1 : 0;
            if (step === 0) return;
            event.preventDefault();
            const visible = tabs.filter((t) => !t.hidden);
            const at = visible.indexOf(tab);
            const target = visible[(at + step + visible.length) % visible.length];
            if (!target) return;
            select(tabs.indexOf(target));
            target.focus();
          });
        });
        term.querySelector("[data-term-replay]")?.addEventListener("click", () => select(current));
        const segments = [...term.querySelectorAll<HTMLButtonElement>("[data-seg]")];
        for (const seg of segments) {
          seg.addEventListener("click", () => {
            for (const s of segments) s.setAttribute("aria-pressed", String(s === seg));
            let first = -1;
            tabs.forEach((tab, i) => {
              tab.hidden = tab.dataset.group !== seg.dataset.seg;
              if (!tab.hidden && first < 0) first = i;
            });
            if (first >= 0) select(first);
          });
        }

        term.classList.add("live");
        const watch = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              watch.disconnect();
              select(0);
            }
          },
          { threshold: 0.4 },
        );
        watch.observe(term);
      }

      // Prints the example service once the board is in view. The ticket slides
      // under whichever station wrote the latest line.
      const board = document.querySelector<HTMLElement>("[data-board]");
      const marker = board?.querySelector<HTMLElement>("[data-marker]");
      if (board && marker) {
        const lines = [...board.querySelectorAll<HTMLElement>("[data-line]")];
        const lamps = [...board.querySelectorAll<HTMLElement>(".lamp")];
        const refire = board.querySelector<HTMLButtonElement>("[data-refire]");
        const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let timers: number[] = [];

        const light = (lamp: string | undefined) => {
          for (const el of lamps) el.classList.toggle("on", el.dataset.lamp === lamp);
          marker.style.setProperty("--pos", lamp ?? "0");
        };

        const play = () => {
          for (const t of timers) clearTimeout(t);
          timers = [];
          if (still) {
            for (const line of lines) line.classList.add("shown");
            light(lines.at(-1)?.dataset.lamp);
            return;
          }
          for (const line of lines) line.classList.remove("shown");
          light(undefined);
          lines.forEach((line, i) => {
            timers.push(
              window.setTimeout(() => {
                line.classList.add("shown");
                light(line.dataset.lamp);
              }, 500 + i * 900),
            );
          });
        };

        board.classList.add("live");
        const seen = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              seen.disconnect();
              play();
            }
          },
          { threshold: 0.3 },
        );
        seen.observe(board);
        refire?.addEventListener("click", play);
      }
    </script>
  </body>
</html>

