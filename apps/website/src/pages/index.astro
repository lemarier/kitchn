---
import {
  siClaude,
  siCoderabbit,
  siCrewai,
  siCursor,
  siGithubcopilot,
  siLanggraph,
} from "simple-icons";
import RoleAvatar from "../components/RoleAvatar.astro";
import ToolChip from "../components/ToolChip.astro";
import { brigadeFor, orcaAgents } from "../data/agents";
import { nightShift } from "../data/autopilot";
import { glossary } from "../data/glossary";
import { commands } from "../data/terminal";
import { roles } from "../lib/roles";

const repository = "https://github.com/lemarier/kitchn";
const installs = [
  {
    id: "shell",
    label: "macOS / Linux",
    command: "curl -fsSL https://getkitchn.com/install.sh | sh",
  },
  { id: "cargo", label: "Cargo", command: "cargo install kitchn --locked" },
] as const;

// The pass board: stations an issue moves through, and what runs each one.
const lamps = [
  { name: "Order in", runs: "GitHub issue", avatar: undefined },
  { name: "Sous-chef", runs: "Orca + Claude Code", avatar: "sous-chef" },
  { name: "Station cook", runs: "Orca + Codex", avatar: "station-cook" },
  { name: "Expediter", runs: "Orca + Claude Code", avatar: "expediter" },
  { name: "Chef-owner", runs: "You", avatar: "chef-owner" },
] as const;

type Line = { lamp: number; time: string; who: string; text: string; flag?: true };
const service: Line[] = [
  {
    lamp: 0,
    time: "09:12",
    who: "Order in",
    text: "#58 Add a retry budget to pickup. Blocked by #57, which is done.",
  },
  {
    lamp: 1,
    time: "09:12",
    who: "Sous-chef",
    text: "Claimed #58. Capacity 2 of 3. Sole writer on kitchn/58.",
  },
  {
    lamp: 2,
    time: "09:13",
    who: "Cook",
    text: "Working in an isolated worktree on Orca with Codex.",
  },
  { lamp: 2, time: "09:39", who: "Cook", text: "Tests pass. Evidence attached. Opened PR #61." },
  {
    lamp: 3,
    time: "09:41",
    who: "Expediter",
    text: "Checking exact head 7c1e9a2 with Claude Code.",
  },
  {
    lamp: 3,
    time: "09:44",
    who: "Expediter",
    text: "Sent back: retry count can overflow. Round 1 of 3.",
    flag: true,
  },
  { lamp: 2, time: "09:52", who: "Cook", text: "Fixed. New head 3b04d17." },
  {
    lamp: 3,
    time: "09:53",
    who: "Expediter",
    text: "Head moved, old approval void. Rechecking 3b04d17.",
    flag: true,
  },
  {
    lamp: 3,
    time: "09:57",
    who: "Expediter",
    text: "Checks green, reviewer approved, no open findings.",
  },
  {
    lamp: 4,
    time: "09:58",
    who: "Chef-owner",
    text: "House rule: merges need your sign-off. Approved 3b04d17.",
  },
  {
    lamp: 4,
    time: "10:03",
    who: "Order up",
    text: "Merged. Worktree kept until cleanup can prove it's done.",
  },
];

const steps = [
  {
    title: "Watch",
    body: "Run a station next to you from your worktree. Nothing runs on a schedule until you turn it on.",
  },
  {
    title: "Correct",
    body: "Fix what's off and write it into house guidance, pinned by revision.",
  },
  {
    title: "Record",
    body: "Each outcome links station, project, model, rules revision, PR and evidence.",
  },
  {
    title: "Hand over",
    body: "Grant autonomy per station, project and kind of work. Never silently, never across houses.",
  },
] as const;

const lookedAt = [
  {
    what: "Coding agents",
    examples: [
      { name: "Claude Code", icon: siClaude },
      { name: "Codex" },
      { name: "Cursor", icon: siCursor },
    ],
    good: "A strong cook.",
    missing: "One cook isn't a brigade. Nobody independent checks the plate.",
  },
  {
    what: "Orchestrators",
    examples: [
      { name: "Orca" },
      { name: "Conductor" },
      { name: "Claude Squad" },
      { name: "Vibe Kanban" },
    ],
    good: "Many agents in parallel worktrees.",
    missing: "They run the line. Who may ship what, and why, is still up to you.",
  },
  {
    what: "Agent frameworks",
    examples: [
      { name: "LangGraph", icon: siLanggraph },
      { name: "CrewAI", icon: siCrewai },
    ],
    good: "Build your own agents in code.",
    missing: "You'd be building the kitchen from scratch.",
  },
  {
    what: "Review bots",
    examples: [
      { name: "CodeRabbit", icon: siCoderabbit },
      { name: "Copilot review", icon: siGithubcopilot },
    ],
    good: "A second opinion on a pull request.",
    missing: "It doesn't hold the merge until the exact head passes your checks and approvals.",
  },
  {
    what: "Governance layers",
    examples: [{ name: "Early projects" }],
    good: "Policy and evidence around agent work.",
    missing:
      "Worth watching. None we found combined portable roles, per-house isolation and earned autonomy across orchestrators.",
  },
];

const guests = [
  {
    title: "You run more agents than you can watch",
    body: "An expediter takes the first pass on every pull request and sends back what fails, with the evidence.",
  },
  {
    title: "You work for more than one house",
    body: "A day job, a client, an open-source project. Each gets its own rules, keys and history, and none of them leak into the others.",
  },
  {
    title: "Your team wants one bar for everyone",
    body: "Agent pull requests meet the same checks, reviewers and approvals as a person's, on the exact revision that merges.",
  },
  {
    title: "You want to hand off more over time",
    body: "Start supervised. Widen a station when its record says it's ready, and not before.",
  },
] as const;

// The complete product, from issue #1 and its sub-issues.
const menu = [
  {
    course: "In your session",
    items: [
      [
        "Work an issue",
        "Hand it an issue from any worktree; it coordinates or implements under your house's rules.",
      ],
      [
        "Review a pull request",
        "Review, follow up, repair conflicts or give a verdict on one PR at its exact head.",
      ],
      [
        "Draft and refine issues",
        "Turn a rough idea into outcome, ownership, acceptance criteria and dependencies.",
      ],
      [
        "Split big projects",
        "Propose dependency-linked sub-issues; nothing is written until you approve the preview.",
      ],
      [
        "Deliberation threads",
        "Several role agents discuss a task and leave one decision record the cook reads.",
      ],
    ],
  },
  {
    course: "On the line",
    items: [
      ["Pickup", "Ready issues are claimed with capacity, dependencies and one writer per branch."],
      [
        "Supervision",
        "Workers ask questions, you answer once, and answers stay bound to the task and revision.",
      ],
      [
        "PR follow-up",
        "Review findings, conflict repair and stacked branches, with bounded rounds.",
      ],
      [
        "Schedules and events",
        "Run on a timer or on forge events, with per-house intervals and usage budgets.",
      ],
      ["Model per station", "Pick the agent, model and effort for each role and kind of work."],
      [
        "Live verification",
        "Cooks can run what they changed on declared targets, and say so in the evidence.",
      ],
    ],
  },
  {
    course: "At the pass",
    items: [
      [
        "Exact-head merge gate",
        "Checks, reviewers, findings and approvals evaluated for one revision.",
      ],
      [
        "Independent review",
        "The reviewer is never the author. A green build or model agreement is not a review.",
      ],
      [
        "Inspector sampling",
        "Merged work is sampled, and sampling rises again after a confirmed regression.",
      ],
      [
        "Readiness reports",
        "Know whether a repository's checks can support autonomous merge before you grant it.",
      ],
    ],
  },
  {
    course: "Earned trust",
    items: [
      [
        "Trust ledger",
        "Outcomes per station, project, work type and model, linked to their evidence.",
      ],
      [
        "Graduation",
        "Move a station from supervised to unattended runs when its record meets your bar.",
      ],
      [
        "Brigade audit",
        "Regular reports on repeated findings, idle schedules and stations that need a split.",
      ],
    ],
  },
  {
    course: "Upkeep",
    items: [
      [
        "Triage and gardener",
        "Specs resolved from evidence, dependencies and issue hygiene kept up.",
      ],
      ["Report intake", "Outside reports grouped into deduplicated issue proposals."],
      ["Dishwasher", "Cleanup only with proof a resource is finished; anything uncertain is kept."],
      [
        "House isolation",
        "Credentials, repositories, posting limits and history never cross houses.",
      ],
      [
        "Invisible in your repos",
        "No kitchn files in working trees; teammates keep working their own way.",
      ],
    ],
  },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>kitchn: run your coding agents like a kitchen</title>
    <meta
      name="description"
      content="kitchn is the workflow layer for coding agents: who picks up an issue, who builds it, who checks it and what may ship. It runs on top of the orchestrator you already use."
    />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;900&family=Hanken+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@400;600&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="top">
      <div class="wrap top-inner">
        <a class="brand" href="/" aria-label="kitchn home">
          <svg viewBox="0 0 32 32" fill-rule="evenodd" aria-hidden="true">
            <path d="M9 11.5c-3.2-.6-3.6-5.6.2-6 .8-3.4 5.2-4.2 6.8-1.6 1.6-2.6 6-1.8 6.8 1.6 3.8.4 3.4 5.4.2 6v1H9Z" />
            <path d="M7 14h18a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-9a3 3 0 0 1 3-3Z M10.5 19a1.8 1.8 0 1 0 3.6 0a1.8 1.8 0 1 0-3.6 0Z M17.9 19a1.8 1.8 0 1 0 3.6 0a1.8 1.8 0 1 0-3.6 0Z M12 24h8v1.6h-8Z" />
          </svg>
          kitchn
        </a>
        <nav aria-label="Primary">
          <a href="/docs/start/introduction/">Docs</a>
          <a class="nav-github" href={repository}>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
            GitHub
          </a>
          <a class="nav-install" href="/docs/start/install/">Install</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <h1 id="hero-title">
          <span>Close the drive&#8209;thru.</span>
          <span>Open a kitchen.</span>
        </h1>
        <p class="lede">
          kitchn is the workflow layer for your coding agents: who picks up an issue, who builds it, who
          checks it and what's allowed to ship. Work with it in your session or put it on autopilot, on
          top of the orchestrator you already use.
        </p>
        <div class="cta">
          <a class="button primary big" href="/docs/start/install/">Install kitchn</a>
          <a class="button big" href={repository}>View on GitHub</a>
        </div>
        <div class="installer" data-installer>
          <div class="installer-tabs" role="tablist" aria-label="Install method">
            {
              installs.map((m, i) => (
                <button type="button" role="tab" id={`tab-${m.id}`} aria-controls={`cmd-${m.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tab={m.id}>
                  {m.label}
                </button>
              ))
            }
          </div>
          {
            installs.map((m, i) => (
              <div class="installer-cmd" role="tabpanel" id={`cmd-${m.id}`} aria-labelledby={`tab-${m.id}`} hidden={i !== 0}>
                <code><span class="prompt" aria-hidden="true">$ </span>{m.command}</code>
                <button type="button" class="copy" data-copy={m.command}>Copy</button>
              </div>
            ))
          }
        </div>
        <p class="setup-note">
          Both arrive with the first release (<a href="https://github.com/lemarier/kitchn/issues/18">#18</a>).
          Until then, <a href="/docs/start/install/#from-source">build from source</a>, then{" "}
          <a href="/docs/start/quickstart/">set up your first house</a>.
        </p>
      </section>

      <section class="factory wrap" aria-labelledby="factory-title">
        <h2 id="factory-title">Right now, you're the whole kitchen.</h2>
        <div class="factory-split">
          <p class="factory-lede">
            Six agents, one of you. You take every order, read every diff, decide what's good enough,
            merge at midnight and clean up worktrees in the morning.
          </p>
          <div class="factory-quote">
            <p class="factory-big">You're not running a software factory.</p>
            <p>
              Factories count units shipped. A good kitchen serves a full room every night and still
              sends back any plate that isn't right. Your agents should work to that standard, as a brigade
              where everyone knows their station.
            </p>
          </div>
        </div>
      </section>

      <section class="brigade" aria-labelledby="brigade-title">
        <div class="wrap">
          <h2 id="brigade-title">Meet the brigade</h2>
          <p class="section-lede">
            Eight stations, each with one job. Every station owes evidence and has a line it can't cross.
            Stations open only when there's work for them.
          </p>
        </div>
        {
          [roles].map((row) => (
            <div class="line">
              <div class="line-rail" aria-hidden="true" />
              <ul class="stations wrap">
                {row.map((role, i) => (
                  <li class="station" style={`--i:${i}`}>
                    <button type="button" class="station-card" data-open={`contract-${role.slug}`} aria-haspopup="dialog">
                      <RoleAvatar slug={role.slug} />
                      <span class="station-name">{role.kitchenName}</span>
                      <span class="station-job">{role.job}</span>
                      <span class="station-more">Contract</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        {
          roles.map((role) => (
            <dialog class="contract" id={`contract-${role.slug}`} aria-labelledby={`contract-${role.slug}-title`}>
              <div class="contract-body">
                <button type="button" class="contract-close" data-close aria-label="Close">
                  Close
                </button>
                <RoleAvatar slug={role.slug} />
                <p class="contract-kind">{role.function}</p>
                <h3 id={`contract-${role.slug}-title`}>{role.kitchenName}</h3>
                <p class="contract-job">{role.job}</p>
                <dl>
                  <dt>Does</dt>
                  <dd>{role.responsibility}</dd>
                  <dt>Owes</dt>
                  <dd>{role.evidence}</dd>
                  <dt>Never</dt>
                  <dd>{role.boundary}</dd>
                </dl>
                <p class="contract-foot">
                  Installing this station starts no worker or schedule and grants no authority.
                </p>
              </div>
            </dialog>
          ))
        }
      </section>

      <section class="pass wrap" aria-labelledby="pass-title">
        <h2 id="pass-title">Follow one order</h2>
        <p class="section-lede">
          Here's issue #58 going through the kitchen. Every station hands over evidence, and nothing
          moves on without it.
        </p>
        <div class="board" data-board>
          <ol class="lamps">
            {
              lamps.map((lamp, i) => (
                <li class="lamp" data-lamp={i}>
                  {lamp.avatar ? (
                    <RoleAvatar slug={lamp.avatar} />
                  ) : (
                    <svg class="avatar" viewBox="0 0 96 96" aria-hidden="true">
                      <path d="M26 22h44v56l-5.5-4-5.5 4-5.5-4-5.5 4-5.5-4-5.5 4-5.5-4-5.5 4Z" />
                      <path d="M34 36h28M34 46h28M34 56h18" />
                    </svg>
                  )}
                  <span class="lamp-name">{lamp.name}</span>
                  <span class="lamp-runs">{lamp.runs}</span>
                </li>
              ))
            }
          </ol>
          <div class="rail-track" aria-hidden="true">
            <span class="marker" data-marker>#58</span>
          </div>
          <div class="printout">
            <div class="printout-head">
              <span>Table you/app</span>
              <span class="printout-order">#58 Add a retry budget to pickup</span>
            </div>
            <ol class="log" aria-live="polite">
              {
                service.map((line) => (
                  <li class:list={["log-line", { flag: line.flag }]} data-line data-lamp={line.lamp}>
                    <span class="log-time">{line.time}</span>
                    <span class="log-who">{line.who}</span>
                    <span class="log-text">{line.text}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="board-foot">
            <p>
              Each station runs on the orchestrator and model you chose for it.
            </p>
            <button class="refire" type="button" data-refire>Fire it again</button>
          </div>
        </div>
      </section>

      <section class="explorer wrap" aria-labelledby="explorer-title">
        <h2 id="explorer-title">Start from your session</h2>
        <p class="section-lede center">
          Open an Orca workspace, type <code>/kitchn</code> and point it at an issue. It reads the
          sub-issues and their dependencies, then runs the whole tree through Orca's worktrees,
          terminals and messaging while you watch and answer.
        </p>
        <div class="term" data-term>
          <svg class="doodle" viewBox="0 0 96 72" aria-hidden="true">
            <path d="M27 33c-8-2-9-14 1-15 2-9 13-11 17-4 4-7 15-5 17 4 10 1 9 13 1 15" />
            <path d="M27 33v5h42v-5" />
            <path d="M20 72V47a9 9 0 0 1 9-9h38a9 9 0 0 1 9 9v25" />
            <circle cx="38" cy="55" r="3.5" />
            <circle cx="58" cy="55" r="3.5" />
            <path d="M42 65h12" />
            <path d="M8 72c0-7 12-7 12 0M76 72c0-7 12-7 12 0" />
          </svg>
          <div class="term-list">
            <div class="term-segments" role="group" aria-label="Kind of command">
              {
                [...new Set(commands.map((c) => c.group))].map((group, i) => (
                  <button type="button" class="term-seg" aria-pressed={i === 0 ? "true" : "false"} data-seg={group}>
                    {group}
                  </button>
                ))
              }
            </div>
            <div class="term-tabs" role="tablist" aria-label="Commands" aria-orientation="vertical">
            {
              commands.map((c, i) => (
                <button type="button" role="tab" id={`term-tab-${c.id}`} aria-controls="term-screen" aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-term-tab={c.id} data-group={c.group} hidden={c.group !== commands[0]?.group}>
                  {c.label}
                </button>
              ))
            }
            </div>
          </div>
          <div class="term-screen" id="term-screen" role="tabpanel">
            <div class="term-bar">
              <span data-term-summary>{commands[0]?.summary}</span>
              <a data-term-docs href={commands[0]?.docs}>docs</a>
              <button type="button" class="term-replay" data-term-replay>Replay</button>
            </div>
            {
              commands.map((c, i) => (
                <pre class="term-out" data-term-out={c.id} data-summary={c.summary} data-docs={c.docs} hidden={i !== 0} aria-hidden={i !== 0 ? "true" : undefined}>
                  {c.lines.map((l) => (
                    <span class:list={["tl", l.tone]}>{(l.tone === "cmd" || l.tone === "you") && <span class="prompt">{l.tone === "you" || l.text.startsWith("/") ? "› " : "$ "}</span>}{l.text}</span>
                  ))}
                </pre>
              ))
            }
          </div>
        </div>
        <div class="beyond">
          <div class="beyond-card">
            <h3>Don't memorize any of this</h3>
            <p>
              The <code>/kitchn</code> skill knows every command. Ask in plain words and it runs the right
              one, shows you the preview and asks before anything changes.
            </p>
            <div class="chat">
              <p class="chat-you">what's still missing for this repo?</p>
              <p class="chat-kitchn">
                Repository access for acme isn't observed yet, and the gate needs a backend with
                scheduling. Want me to walk you through both?
              </p>
            </div>
          </div>
          <div class="beyond-side">
            <div class="beyond-card soon">
              <p class="stamp">Coming soon</p>
              <h3>The dashboard</h3>
              <p>
                Every order on the line, what's waiting on you, and what each station has earned, for
                your whole house in one place.
              </p>
            </div>
            <div class="beyond-card soon">
              <p class="stamp">Coming soon</p>
              <h3>Roger</h3>
              <p>
                When a station needs a decision, Roger brings the question to you wherever you are. Your
                answer goes straight back to the task and revision that asked, once, and never to
                another house.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="autopilot" aria-labelledby="autopilot-title">
        <div class="wrap">
          <h2 id="autopilot-title">Put it on autopilot</h2>
          <p class="section-lede">
            Once a station has earned it, close the laptop. The brigade keeps cooking on the stations
            you've trusted, stays inside the house budget, and leaves the calls that need you on the
            pass for the morning.
          </p>
          <ol class="steps">
            {
              steps.map((step) => (
                <li class="step">
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </li>
              ))
            }
          </ol>
          <div class="shift">
            <ol class="shift-log">
              {
                nightShift.log.map((e) => (
                  <li class:list={[e.tone]}>
                    <span class="shift-time">{e.time}</span>
                    <span class="shift-who">{e.who}</span>
                    <span class="shift-text">{e.text}</span>
                  </li>
                ))
              }
            </ol>
            <div class="report">
              <p class="report-head">
                <span>Service report</span>
                <span>07:30</span>
              </p>
              <p class="report-title">Good morning. Here's last night at {nightShift.house}.</p>
              <dl>
                {
                  nightShift.report.map((r) => (
                    <div class:list={[r.tone]}>
                      <dt>{r.label}</dt>
                      <dd>{r.value}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
          <ul class="guardrails">
            <li>
              <h3>One house at a time</h3>
