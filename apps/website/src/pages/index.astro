    border-color: var(--ink);
  }
  .button.big {
    font-size: 1.125rem;
    padding: 1rem 1.75rem;
  }
  .button.primary {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
  }
  .button.primary:hover {
    background: #fff;
    border-color: #fff;
    color: var(--print);
  }

  .installer {
    width: min(100%, 44rem);
    margin: 2.5rem auto 0;
    text-align: left;
    background: var(--steel);
    border: 1px solid var(--steel-edge);
    border-radius: 8px;
    overflow: hidden;
  }
  .installer-tabs {
    display: flex;
    border-bottom: 1px solid var(--steel-edge);
  }
  .installer-tabs button {
    font: 500 0.875rem/1 var(--body);
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.9rem 1.1rem 0.8rem;
    cursor: pointer;
  }
  .installer-tabs button[aria-selected="true"] {
    color: var(--ink);
    border-bottom-color: var(--red);
  }
  .installer-cmd {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1rem 1.1rem 1.25rem;
  }
  .installer-cmd[hidden] {
    display: none;
  }
  .installer-cmd code {
    flex: 1;
    min-width: 0;
    font: 400 clamp(0.8125rem, 1.6vw, 1.0625rem)/1.5 var(--mono);
    white-space: nowrap;
    overflow-x: auto;
  }
  .prompt {
    color: var(--red);
    user-select: none;
  }
  .copy {
    flex: none;
    font: 600 0.8125rem/1 var(--mono);
    color: var(--ink);
    background: var(--steel-2);
    border: 1px solid var(--steel-edge);
    border-radius: 4px;
    padding: 0.55rem 0.8rem;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--ink);
  }
  .setup-note {
    margin: 0.9rem 0 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .setup-note a {
    color: var(--ink);
  }

  /* The pass board: heat lamps, a steel rail, and one ticket printing. */
  .board {
    background: var(--steel);
    border: 1px solid var(--steel-edge);
    border-radius: 10px;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .lamps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .lamp {
    display: grid;
    justify-items: center;
    text-align: center;
    padding: 1rem 0.5rem 1.1rem;
    background: var(--steel-2);
    border: 1px solid var(--steel-edge);
    border-top: 4px solid var(--steel-edge);
    border-radius: 6px;
    color: var(--ink-soft);
    transition: border-color 250ms, color 250ms, transform 250ms;
  }
  .lamp .avatar {
    width: 4.5rem;
    height: 4.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lamp.on {
    color: var(--lamp);
    border-color: var(--lamp);
    transform: translateY(-4px);
  }
  .lamp-name {
    display: block;
    margin-top: 0.4rem;
    font: 900 1.4rem/1 var(--display);
    text-transform: uppercase;
    color: var(--ink);
  }
  .lamp.on .lamp-name {
    color: var(--lamp);
  }
  .lamp-runs {
    display: block;
    margin-top: 0.35rem;
    font: 400 0.75rem/1.4 var(--mono);
    color: var(--ink-soft);
  }

  .rail-track {
    position: relative;
    height: 2.75rem;
    margin-top: 1rem;
  }
  .rail-track::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0.3rem;
    height: 10px;
    border-radius: 5px;
    background: linear-gradient(180deg, #e9eef0 0%, #b9c3c9 40%, #7f8c94 75%, #5d6870 100%);
  }
  .marker {
    --pos: 0;
    position: absolute;
    top: 0;
    left: calc((var(--pos) * 2 + 1) * 10%);
    transform: translateX(-50%);
    background: var(--paper);
    color: var(--print);
    font: 600 0.8125rem/1 var(--mono);
    padding: 0.55rem 0.6rem 0.7rem;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 8px 100%;
    transition: left 600ms cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .printout {
    background: var(--paper);
    color: var(--print);
    font: 400 0.8125rem/1.5 var(--mono);
    padding: 1.25rem clamp(1rem, 3vw, 1.75rem) 1.75rem;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 12px 100%;
  }
  .printout-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px dashed var(--print);
    margin-bottom: 0.6rem;
  }
  .printout-order {
    font-weight: 600;
    text-align: right;
  }

  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .log-line {
    display: grid;
    grid-template-columns: 3rem 6.25rem minmax(0, 1fr);
    gap: 0 0.75rem;
    padding: 0.2rem 0;
  }
  .live .log-line {
    visibility: hidden;
  }
  .live .log-line.shown {
    visibility: visible;
    animation: print 220ms ease-out;
  }
  @keyframes print {
    from {
      opacity: 0;
      transform: translateY(-3px);
    }
  }
  .log-who {
    font-weight: 600;
  }
  .log-line.flag .log-text {
    color: var(--print-red);
    font-weight: 600;
  }

  .board-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
  }
  .board-foot p {
    margin: 0;
    max-width: var(--measure);
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
  .refire {
    font: 600 0.8125rem/1 var(--mono);
    color: var(--ink);
    background: var(--steel-2);
    border: 1px solid var(--steel-edge);
    border-radius: 4px;
    padding: 0.6rem 0.9rem;
    cursor: pointer;
  }
  .refire:hover {
    border-color: var(--ink);
  }
  .pass-note {
    margin: 0.9rem 0 0;
    text-align: center;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  /* Sections. */
  section.wrap:not(.hero, .pass) {
    padding-top: clamp(5rem, 11vw, 8.5rem);
  }
  section h2 {
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
    max-width: 22ch;
  }
  .section-lede {
    max-width: var(--measure);
    margin: 1.25rem 0 0;
    color: var(--ink-soft);
    font-size: 1.125rem;
  }

  /* Layers. */
  .stack {
    display: grid;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .layer {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 0.5rem 2rem;
    align-items: center;
    padding: 1.2rem 1.5rem;
    background: var(--steel);
    border: 1px solid var(--steel-edge);
    border-radius: 6px;
  }
  .layer.own {
    background: var(--red);
    border-color: var(--red);
    color: #fff;
    padding-block: 1.75rem;
  }
  .layer-name {
    font: 900 1.9rem/1 var(--display);
    text-transform: uppercase;
  }
  .layer.own .layer-name {
    font-size: 2.6rem;
  }
  .layer-body {
    color: var(--ink-soft);
  }
  .layer.own .layer-body {
    color: #fff;
    font-weight: 500;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    font: 400 0.8125rem/1 var(--mono);
    color: var(--ink);
    background: var(--steel-2);
    border: 1px solid var(--steel-edge);
    border-radius: 4px;
    padding: 0.5rem 0.65rem;
  }
  .chip.ghost {
    color: var(--ink-soft);
    background: none;
    border-style: dashed;
  }

  /* The problem. */
  .factory h2 {
    max-width: 14ch;
  }
  .factory-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 6vw, 5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }
  .factory-lede {
    margin: 0;
    font-size: clamp(1.125rem, 1.8vw, 1.3rem);
    color: var(--ink-soft);
  }
  .factory-quote {
    padding-left: 1.5rem;
    border-left: 3px solid var(--red);
  }
  .factory-big {
    margin: 0;
    font: 900 clamp(1.9rem, 3.5vw, 2.75rem)/1 var(--display);
    text-transform: uppercase;
    color: var(--red);
  }
  .factory-quote p + p {
    margin: 1rem 0 0;
    color: var(--ink-soft);
  }

  .steps {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    counter-reset: step;
  }
  .step {
    counter-increment: step;
    padding: 1.25rem 1.5rem 0 0;
    border-top: 3px solid var(--ink);
  }
  .step + .step {
    padding-left: 1.5rem;
    border-left: 1px solid var(--steel-edge);
  }
  .step h3 {
    font-size: 1.6rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .step h3::before {
    content: counter(step);
    color: var(--red);
  }
  .step p {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
  }

  /* Rotating name in "A brigade for ___". */
  .byo h2 {
    max-width: none;
    text-align: center;
  }
  .byo h2 + .section-lede {
    margin-inline: auto;
    text-align: center;
  }
  .rotator {
    display: grid;
    justify-items: center;
    overflow: hidden;
    color: var(--red);
  }
  .rot {
    grid-area: 1 / 1;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.6em);
    transition: opacity 350ms ease, transform 350ms ease;
  }
  .rot.on {
    opacity: 1;
    transform: none;
  }
  .rot.out {
    opacity: 0;
    transform: translateY(-0.6em);
  }

  /* Agent wall. */
  .agent-wall {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    text-align: center;
  }
  .agent-count {
    margin: 0;
    font: 900 clamp(2rem, 4vw, 3rem)/1 var(--display);
    text-transform: uppercase;
  }
  .agent-count span {
    display: block;
    font-size: clamp(5rem, 14vw, 10rem);
    line-height: 0.85;
    color: var(--red);
  }
  .agent-note {
    max-width: 36rem;
    margin: 1.25rem auto 0;
    color: var(--ink-soft);
  }
  .agent-chips {
    justify-content: center;
    max-width: 60rem;
    margin: 2rem auto 0;
  }
  .agent-source {
    margin: 1.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }

  /* Brigade: tickets hanging from a rail, one per station. */
  section.brigade {
    padding-top: clamp(5rem, 11vw, 8.5rem);
  }
  .line-rail {
    height: 14px;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    background: linear-gradient(180deg, #e9eef0 0%, #b9c3c9 40%, #7f8c94 75%, #5d6870 100%);
    box-shadow: 0 6px 10px -4px rgb(0 0 0 / 55%);
    position: relative;
    z-index: 2;
  }
  .stations {
    list-style: none;
    margin-top: -8px;
    padding: 0 0 2rem;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.75rem;
    align-items: stretch;
  }
  .station {
    position: relative;
    display: flex;
    transition: transform 200ms ease;
  }
  .station:hover,
  .station:focus-within {
    transform: translateY(4px);
  }
  .station-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    justify-items: center;
    align-items: start;
    width: 100%;
    gap: 0.45rem;
    padding: 1.8rem 0.7rem 1.3rem;
    text-align: center;
    font: inherit;
    color: var(--print);
    background: var(--paper);
    border: 0;
    cursor: pointer;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 12px 100%;
    box-shadow: 0 18px 28px -16px rgb(0 0 0 / 70%);
  }
  .station .avatar {
    width: 5.5rem;
    height: 5.5rem;
    color: var(--print);
    margin-bottom: -0.25rem;
  }
  .station-card:hover .avatar,
  .station-card:focus-visible .avatar {
    color: var(--print-red);
  }
  .station-name {
    font: 900 1.35rem/1 var(--display);
    text-transform: uppercase;
  }
  .station-job {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: #3b4750;
    max-width: 17rem;
  }
  .station-more {
    margin-top: 0.4rem;
    padding-top: 0.7rem;
    width: 100%;
    border-top: 2px dashed var(--print);
    font: 600 0.75rem/1 var(--mono);
    color: var(--print-red);
  }

  .contract {
    width: min(34rem, calc(100% - 2rem));
    max-height: calc(100% - 2rem);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--print);
    overflow: visible;
  }
  .contract::backdrop {
    background: rgb(8 11 13 / 78%);
    backdrop-filter: blur(3px);
  }
  .contract[open] {
    animation: contract-in 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes contract-in {
    from {
      opacity: 0;
      transform: translateY(12px) rotate(-1deg);
    }
  }
  .contract-body {
    position: relative;
    background: var(--paper);
    padding: 1.75rem clamp(1.25rem, 4vw, 2.25rem) 2.25rem;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / 12px 100%;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
  }
  .contract .avatar {
    width: 6.5rem;
    height: 6.5rem;
    margin-left: -0.75rem;
  }
  .contract-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font: 600 0.8125rem/1 var(--mono);
    color: var(--print);
    background: none;
    border: 2px solid var(--print);
    border-radius: 3px;
    padding: 0.45rem 0.6rem;
    cursor: pointer;
  }
  .contract-close:hover {
    background: var(--print);
    color: var(--paper);
  }
  .contract-kind {
    margin: 0.25rem 0 0;
    font: 600 0.8125rem/1 var(--mono);
    color: var(--print-red);
  }
  .contract h3 {
    font-family: var(--display);
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
    margin-top: 0.4rem;
    font-size: 2.75rem;
  }
  .contract-job {
    margin: 0.6rem 0 0;
    padding-bottom: 1rem;
    border-bottom: 2px dashed var(--print);
    font-size: 1.0625rem;
  }
  .contract dl {
    margin: 0;
  }
  .contract dt {
    margin-top: 1rem;
    font: 600 0.8125rem/1 var(--mono);
    color: var(--print-red);
  }
  .contract dd {
    margin: 0.35rem 0 0;
    line-height: 1.55;
  }
  .contract-foot {
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid #e3ddcb;
    font-size: 0.875rem;
    color: #5b6770;
  }

  /* We looked first. */
  .review {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--steel-edge);
  }
  .review-row {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 0.5rem 2.5rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--steel-edge);
  }
  .review-row p {
    margin: 0;
  }
  .review-heads {
    font: 400 0.8125rem/1 var(--mono);
    color: var(--ink-soft);
    padding-block: 0.9rem;
    border-top: 0;
  }
  .review-what p {
    margin: 0;
    font: 900 1.6rem/1 var(--display);
    text-transform: uppercase;
  }
  .review-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.7rem;
  }
  .review-good {
    color: var(--ink-soft);
  }
  .verdict {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    font: 900 clamp(2.4rem, 6vw, 4.5rem)/0.95 var(--display);
    text-transform: uppercase;
    color: var(--red);
  }

  /* Who it's for. */
  .guest-list {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 4rem;
  }
  .guest-list li {
    padding-top: 1.25rem;
    border-top: 3px solid var(--ink);
  }
  .guest-list h3 {
    font-size: 1.45rem;
    max-width: 18ch;
  }
  .guest-list p {
    margin: 0.75rem 0 0;
    color: var(--ink-soft);
  }
  .not-yet {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    color: var(--ink-soft);
  }

  /* The menu, printed on paper. */
  .menu-card {
    background: var(--paper);
    color: var(--print);
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: 3px;
  }
  .menu-note {
    max-width: var(--measure);
    margin: 1rem 0 0;
    color: #4b5862;
  }
  .courses {
    columns: 2 22rem;
    column-gap: 4rem;
    margin-top: 2.5rem;
  }
  .course {
    break-inside: avoid;
    margin-bottom: 2.5rem;
  }
  .menu h3 {
    font-size: 1.4rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px dashed var(--print);
  }
  .course dl {
    margin: 0;
  }
  .dish {
    padding: 0.7rem 0;
    border-bottom: 1px solid #e3ddcb;
  }
  .dish dt {
    font-weight: 700;
  }
  .dish dd {
    margin: 0.15rem 0 0;
    font-size: 0.9375rem;
    color: #4b5862;
  }

  .final {
    text-align: center;
    padding-bottom: clamp(5rem, 11vw, 8rem);
  }
  .final-kicker {
    margin: 0 0 0.75rem;
    font: 900 clamp(1.4rem, 2.6vw, 2rem)/1 var(--display);
    text-transform: uppercase;
    color: var(--red);
  }
  .final h2,
  .final .section-lede {
    margin-inline: auto;
  }

  .bottom {
    border-top: 1px solid var(--steel-edge);
    color: var(--ink-soft);
    font-size: 0.9375rem;
    padding-block: 2rem;
  }
  .bottom-inner {
    flex-wrap: wrap;
  }
  .bottom p {
    margin: 0;
  }

  .center {
    margin-inline: auto;
    text-align: center;
  }
  .section-lede code {
    font: 400 0.9em var(--mono);
    color: var(--ink);
  }
  .explorer h2 {
    margin-inline: auto;
    text-align: center;
  }

  /* Glossary. */
  .terms {
    margin: clamp(2rem, 5vw, 3rem) 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem 2rem;
  }
  .terms div {
    padding-top: 0.9rem;
    border-top: 2px dashed var(--steel-edge);
  }
  .terms dt {
    font: 900 1.6rem/1 var(--display);
    text-transform: uppercase;
  }
  .terms dd {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }
  .talk-more {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 700;
  }

  /* Command explorer, after a terminal with a command list. */
  .term {
    position: relative;
    display: grid;
    grid-template-columns: 17.5rem minmax(0, 1fr);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    background: #0c1012;
    border: 1px solid var(--steel-edge);
    border-radius: 10px;
  }
  .doodle {
    position: absolute;
    width: 6rem;
    top: calc(-4.5rem + 1px);
    right: 2.5rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .doodle circle {
    fill: var(--ink);
    stroke: none;
  }
  .term-list {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--steel-edge);
  }
  .term-list button {
    text-align: left;
    font: 400 0.875rem/1 var(--mono);
    color: var(--ink-soft);
    background: none;
    border: 0;
    border-bottom: 1px solid #1f272c;
    padding: 1.05rem 1rem;
    cursor: pointer;
  }
  .term-tabs {
    display: flex;
    flex-direction: column;
  }
  .term-list button:hover {
    color: var(--ink);
  }
